{
  "manifest_version": 3,
  "name": "QueueCat",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Batch paste Katfile links; QueueCat manages the queue and hands downloads to Chrome.",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "notifications",
    "nativeMessaging",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://katfile.com/*",
    "https://katfile.biz/*",
    "https://www.katfile.com/*",
    "https://www.katfile.biz/*",
    "https://hitomi.la/*",
    "https://ltn.gold-usergeneratedcontent.net/*",
    "https://w1.gold-usergeneratedcontent.net/*",
    "https://w2.gold-usergeneratedcontent.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "QueueCat — Leave the waiting to the cat.",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://katfile.com/*",
        "https://katfile.biz/*",
        "https://www.katfile.com/*",
        "https://www.katfile.biz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
