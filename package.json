{
  "name": "queuecat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-content.mjs && node scripts/publish-extension.mjs && node scripts/verify-dist.mjs && node scripts/package.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser/run.mjs",
    "test:extraction-browser": "node tests/browser/extraction.mjs",
    "build:helper": "node scripts/package-native.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@types/chrome": "^0.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
